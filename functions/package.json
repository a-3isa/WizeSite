{
  "name": "buildtrack-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions --config ../firebase.deploy.json",
    "lint": "echo \"No lint configured\"",
    "backfill:entity-last-used": "npm run build && node lib/entity_last_used_backfill.js",
    "init:worker-accounting-summaries": "npm run build && node lib/worker_accounting_summary_initializer.js",
    "test": "npm run build && node --test \"lib/**/*.test.js\""
  },
  "dependencies": {
    "firebase-admin": "13.10.0",
    "firebase-functions": "7.2.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.15.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
