# Copy to /srv/wizesite/secrets/restic.env (root-only, mode 0600) and fill in (tasks.md T093).
# Used by ops/systemd/restic-*.service, which run restic from its official image, so nothing is
# installed on the host.

# S3-compatible bucket: Backblaze B2 (s3.<region>.backblazeb2.com) or Cloudflare R2
# (<account-id>.r2.cloudflarestorage.com). Same bucket as pgBackRest, different prefix.
RESTIC_REPOSITORY=s3:https://<endpoint>/<bucket>/wizesite/files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 only:
# AWS_DEFAULT_REGION=auto

# Repository encryption password. Store a copy outside the VPS (password manager): without it
# the backups cannot be read.
RESTIC_PASSWORD=
