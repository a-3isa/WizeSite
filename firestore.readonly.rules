rules_version = '2';

// Cutover (tasks.md T100, ops/CUTOVER.md): Firestore becomes read-only for the rollback window.
// Signed-in users can still read (an old app build would show data instead of failing), nothing
// can be written from a client. The rollback tool writes with the Admin SDK, which bypasses rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
