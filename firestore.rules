rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membershipDocId(workspaceId, userId) {
      return workspaceId + "_" + userId;
    }

    function hasMembership(workspaceId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/memberships/$(membershipDocId(workspaceId, request.auth.uid))
        );
    }

    function isWorkspaceOwner(workspaceId) {
      return signedIn()
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId))
        && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    function inWorkspace(workspaceId) {
      return hasMembership(workspaceId) || isWorkspaceOwner(workspaceId);
    }

    function accountingRoleFor(workspaceId) {
      return get(
        /databases/$(database)/documents/memberships/$(membershipDocId(workspaceId, request.auth.uid))
      ).data.role;
    }

    function canAccessAccounting(workspaceId) {
      return isWorkspaceOwner(workspaceId)
        || (
          hasMembership(workspaceId)
          && accountingRoleFor(workspaceId) in ["owner", "admin", "accountingApproved"]
        );
    }

    function canCreateUserDoc(userId) {
      return signedIn()
        && request.auth.uid == userId
        && (
          request.resource.data.workspaceId == null
          || (
            request.resource.data.workspaceId is string
            && request.resource.data.workspaceId.size() > 0
            && isWorkspaceOwner(request.resource.data.workspaceId)
          )
        );
    }

    function validProjectStatus(status) {
      return status in ["active", "paused", "completed", "cancelled"];
    }

    function validExpenseCategory(category) {
      return category in ["labor", "materials", "equipment", "transport", "other"];
    }

    function validPaymentMethod(method) {
      return method in ["cash", "bank", "check"];
    }

    function validWorkerBillingType(type) {
      return type in ["daily", "project"];
    }

    function validWorkerStatus(status) {
      return status in ["active", "inactive", "terminated"];
    }

    function validPaymentStatus(status) {
      return status in ["paid", "unpaid", "partial"];
    }

    function validAccountingRecord(data) {
      return canAccessAccounting(data.workspaceId)
        && data.workspaceId is string
        && data.workspaceId.size() > 0
        && data.projectId is string
        && data.projectId.size() > 0
        && data.description is string
        && data.amount is number
        && data.amount > 0
        && data.date is timestamp
        && data.paymentMethod is string
        && validPaymentStatus(data.paymentStatus)
        && data.notes is string;
    }

    function validWorkerAccountingRecord(data) {
      return validAccountingRecord(data)
        && data.workerId is string
        && data.workerId.size() > 0
        && data.workerName is string
        && (
          data.paymentStatus != "partial"
          || (
            data.paidAmount is number
            && data.paidAmount > 0
            && data.paidAmount < data.amount
          )
        );
    }

    function validDomainAccountingRecord(data, ownerIdField, ownerNameField) {
      return validAccountingRecord(data)
        && data[ownerIdField] is string
        && data[ownerIdField].size() > 0
        && data[ownerNameField] is string;
    }

    function validWorkerDailyWageForBillingType(dailyWage, billingType) {
      return (
        billingType == "daily"
        && dailyWage is number
        && dailyWage > 0
      ) || (
        billingType == "project"
        && dailyWage is number
        && dailyWage >= 0
      );
    }

    function validProjectUpdate(projectId) {
      return inWorkspace(resource.data.workspaceId)
        && request.resource.data.id == projectId
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.clientName is string
        && request.resource.data.contractValue is number
        && request.resource.data.contractValue > 0
        && request.resource.data.startDate is timestamp
        && (
          request.resource.data.expectedEndDate == null
          || request.resource.data.expectedEndDate is timestamp
        )
        && request.resource.data.location is string
        && request.resource.data.description is string
        && (
          request.resource.data.budgetLimit == null
          || (
            request.resource.data.budgetLimit is number
            && request.resource.data.budgetLimit > 0
          )
        )
        && request.resource.data.completionPercentage is number
        && request.resource.data.completionPercentage >= 0
        && request.resource.data.completionPercentage <= 100
        && validProjectStatus(request.resource.data.status)
        && request.resource.data.isArchived is bool
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name",
          "clientName",
          "contractValue",
          "startDate",
          "expectedEndDate",
          "location",
          "description",
          "budgetLimit",
          "completionPercentage",
          "status",
          "isArchived",
          "updatedAt"
        ]);
    }

    function validExpenseUpdate(expenseId) {
      return inWorkspace(resource.data.workspaceId)
        && request.resource.data.id == expenseId
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.projectName == resource.data.projectName
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.isArchived == resource.data.isArchived
        && validExpenseCategory(request.resource.data.category)
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.date is timestamp
        && request.resource.data.notes is string
        && request.resource.data.supplierName is string
        && request.resource.data.paymentMethod is string
        && request.resource.data.inputMethod == resource.data.inputMethod
        && request.resource.data.transcript == resource.data.transcript
        && request.resource.data.source == resource.data.source
        && request.resource.data.storagePath == resource.data.storagePath
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "category",
          "amount",
          "date",
          "notes",
          "supplierName",
          "paymentMethod",
          "updatedAt"
        ]);
    }

    function validPaymentUpdate(paymentId) {
      return inWorkspace(resource.data.workspaceId)
        && request.resource.data.id == paymentId
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.isArchived == resource.data.isArchived
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.date is timestamp
        && validPaymentMethod(request.resource.data.paymentMethod)
        && request.resource.data.notes is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "amount",
          "date",
          "paymentMethod",
          "notes",
          "updatedAt"
        ]);
    }

    function validWorkerWrite() {
      return inWorkspace(request.resource.data.workspaceId)
        && request.resource.data.workspaceId is string
        && request.resource.data.workspaceId.size() > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.phoneNumber is string
        && request.resource.data.billingType is string
        && validWorkerBillingType(request.resource.data.billingType)
        && validWorkerDailyWageForBillingType(
          request.resource.data.dailyWage,
          request.resource.data.billingType
        )
        && request.resource.data.workerType is string
        && request.resource.data.notes is string
        && request.resource.data.isArchived is bool
        && (
          !request.resource.data.keys().hasAny(["status"])
          || validWorkerStatus(request.resource.data.status)
        );
    }

    function validWorkerUpdate() {
      return inWorkspace(resource.data.workspaceId)
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.phoneNumber is string
        && request.resource.data.billingType is string
        && validWorkerBillingType(request.resource.data.billingType)
        && validWorkerDailyWageForBillingType(
          request.resource.data.dailyWage,
          request.resource.data.billingType
        )
        && request.resource.data.workerType is string
        && request.resource.data.notes is string
        && request.resource.data.isArchived is bool
        && (
          !request.resource.data.keys().hasAny(["status"])
          || validWorkerStatus(request.resource.data.status)
        )
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name",
          "phoneNumber",
          "dailyWage",
          "billingType",
          "workerType",
          "notes",
          "status",
          "isArchived",
          "updatedAt"
        ]);
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if canCreateUserDoc(userId);
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if inWorkspace(workspaceId);
      allow update: if isWorkspaceOwner(workspaceId);
      allow delete: if false;
    }

    match /memberships/{membershipId} {
      // Allow read if user is in that workspace, or reading their own membership (e.g. after login to resolve workspace)
      allow read: if signedIn() && (
        inWorkspace(resource.data.workspaceId) ||
        resource.data.userId == request.auth.uid
      );
      allow create: if signedIn()
        && request.resource.data.workspaceId is string
        && request.resource.data.workspaceId.size() > 0
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.role in ["owner", "admin", "accountingApproved", "member", "entryOnly"]
        && membershipId == membershipDocId(
          request.resource.data.workspaceId,
          request.resource.data.userId
        )
        && isWorkspaceOwner(request.resource.data.workspaceId);
      allow update, delete: if false;
    }

    match /projects/{projectId} {
      allow read: if inWorkspace(resource.data.workspaceId);
      allow create, delete: if false;
      allow update: if validProjectUpdate(projectId);
    }

    match /expenses/{expenseId} {
      allow read: if inWorkspace(resource.data.workspaceId);
      allow create, delete: if false;
      allow update: if validExpenseUpdate(expenseId);
    }

    match /payments/{paymentId} {
      allow read: if inWorkspace(resource.data.workspaceId);
      allow create, delete: if false;
      allow update: if validPaymentUpdate(paymentId);
    }

    match /worker_entries/{entryId} {
      allow read: if inWorkspace(resource.data.workspaceId);
      allow create, update, delete: if false;
    }

    match /worker_accounting_records/{recordId} {
      allow read: if canAccessAccounting(resource.data.workspaceId);
      allow create: if validWorkerAccountingRecord(request.resource.data);
      allow update: if canAccessAccounting(resource.data.workspaceId)
        && request.resource.data.workspaceId == resource.data.workspaceId
        && validWorkerAccountingRecord(request.resource.data);
      allow delete: if canAccessAccounting(resource.data.workspaceId);
    }

    match /contractor_accounting_records/{recordId} {
      allow read: if canAccessAccounting(resource.data.workspaceId);
      allow create: if validDomainAccountingRecord(request.resource.data, "contractorId", "contractorName");
      allow update: if canAccessAccounting(resource.data.workspaceId)
        && request.resource.data.workspaceId == resource.data.workspaceId
        && validDomainAccountingRecord(request.resource.data, "contractorId", "contractorName");
      allow delete: if canAccessAccounting(resource.data.workspaceId);
    }

    match /equipment_accounting_records/{recordId} {
      allow read: if canAccessAccounting(resource.data.workspaceId);
      allow create: if validDomainAccountingRecord(request.resource.data, "equipmentId", "equipmentName");
      allow update: if canAccessAccounting(resource.data.workspaceId)
        && request.resource.data.workspaceId == resource.data.workspaceId
        && validDomainAccountingRecord(request.resource.data, "equipmentId", "equipmentName");
      allow delete: if canAccessAccounting(resource.data.workspaceId);
    }

    match /transport_provider_accounting_records/{recordId} {
      allow read: if canAccessAccounting(resource.data.workspaceId);
      allow create: if validDomainAccountingRecord(request.resource.data, "providerId", "providerName");
      allow update: if canAccessAccounting(resource.data.workspaceId)
        && request.resource.data.workspaceId == resource.data.workspaceId
        && validDomainAccountingRecord(request.resource.data, "providerId", "providerName");
      allow delete: if canAccessAccounting(resource.data.workspaceId);
    }

    match /workers/{workerId} {
      allow read: if inWorkspace(resource.data.workspaceId);
      allow create: if validWorkerWrite();
      allow update: if validWorkerUpdate();
      allow delete: if false;
    }

    match /entities/{entityId} {
      // Directory + autocomplete reads are visible to any workspace member.
      allow read: if inWorkspace(resource.data.workspaceId);
      allow create: if inWorkspace(request.resource.data.workspaceId)
        && request.resource.data.workspaceId is string
        && request.resource.data.workspaceId.size() > 0
        && request.resource.data.name is string;
      // Members may touch lastUsedAt / id / attachments but not reassign the workspace.
      allow update: if inWorkspace(resource.data.workspaceId)
        && request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if false;
    }

    match /subscriptions/{workspaceId} {
      allow read: if inWorkspace(workspaceId);
      allow write: if false;
    }

    match /usage_counters/{counterId} {
      allow read: if inWorkspace(resource.data.workspaceId);
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && request.auth.uid == resource.data.targetUserId
        && inWorkspace(resource.data.workspaceId);
      allow update: if signedIn()
        && request.auth.uid == resource.data.targetUserId
        && inWorkspace(resource.data.workspaceId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"])
        && request.resource.data.readAt is timestamp;
      allow create, delete: if false;
    }

    match /workspace_metrics/{workspaceId} {
      allow read: if canAccessAccounting(workspaceId);
      allow write: if false;
    }

    match /project_metrics/{projectId} {
      allow read: if canAccessAccounting(resource.data.workspaceId);
      allow write: if false;
    }

    match /worker_accounting_summaries/{summaryId} {
      allow read: if canAccessAccounting(resource.data.workspaceId);
      allow write: if false;
    }

    match /attachments/{attachmentId} {
      allow read: if canAccessAccounting(resource.data.workspaceId);
      allow write: if false;
    }

    match /reports/{reportId} {
      allow read: if canAccessAccounting(resource.data.workspaceId);
      allow write: if false;
    }

    match /report_exports/{exportId} {
      allow read: if canAccessAccounting(resource.data.workspaceId);
      allow write: if false;
    }

    match /project_summaries/{summaryId} {
      allow read: if canAccessAccounting(resource.data.workspaceId);
      allow write: if false;
    }

    match /weekly_summaries/{summaryId} {
      allow read: if canAccessAccounting(resource.data.workspaceId);
      allow write: if false;
    }

    match /entity_summaries/{summaryId} {
      allow read: if canAccessAccounting(resource.data.workspaceId);
      allow write: if false;
    }

    match /category_summaries/{summaryId} {
      allow read: if canAccessAccounting(resource.data.workspaceId);
      allow write: if false;
    }

    match /drafts/{draftId} {
      allow read: if inWorkspace(resource.data.workspaceId);
      allow create: if inWorkspace(request.resource.data.workspaceId);
      allow update, delete: if inWorkspace(resource.data.workspaceId);
    }
  }
}
