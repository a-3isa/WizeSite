rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membershipDocId(workspaceId, userId) {
      return workspaceId + "_" + userId;
    }

    function hasMembership(workspaceId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/memberships/$(membershipDocId(workspaceId, request.auth.uid))
        );
    }

    function isWorkspaceOwner(workspaceId) {
      return signedIn()
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId))
        && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    function inWorkspace(workspaceId) {
      return hasMembership(workspaceId) || isWorkspaceOwner(workspaceId);
    }

    function canCreateUserDoc(userId) {
      return signedIn()
        && request.auth.uid == userId
        && (
          request.resource.data.workspaceId == null
          || (
            request.resource.data.workspaceId is string
            && request.resource.data.workspaceId.size() > 0
            && isWorkspaceOwner(request.resource.data.workspaceId)
          )
        );
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if canCreateUserDoc(userId);
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if inWorkspace(workspaceId);
      allow update: if isWorkspaceOwner(workspaceId);
      allow delete: if false;
    }

    match /memberships/{membershipId} {
      // Allow read if user is in that workspace, or reading their own membership (e.g. after login to resolve workspace)
      allow read: if signedIn() && (
        inWorkspace(resource.data.workspaceId) ||
        resource.data.userId == request.auth.uid
      );
      allow create: if signedIn()
        && request.resource.data.workspaceId is string
        && request.resource.data.workspaceId.size() > 0
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.role in ["owner", "member"]
        && membershipId == membershipDocId(
          request.resource.data.workspaceId,
          request.resource.data.userId
        )
        && isWorkspaceOwner(request.resource.data.workspaceId);
      allow update, delete: if false;
    }

    match /projects/{projectId} {
      allow read: if inWorkspace(resource.data.workspaceId);
      allow create: if signedIn() && inWorkspace(request.resource.data.workspaceId);
      allow update, delete: if inWorkspace(resource.data.workspaceId);
    }

    match /expenses/{expenseId} {
      allow read: if inWorkspace(resource.data.workspaceId);
      allow create: if signedIn() && inWorkspace(request.resource.data.workspaceId);
      allow update, delete: if inWorkspace(resource.data.workspaceId);
    }

    match /payments/{paymentId} {
      allow read: if inWorkspace(resource.data.workspaceId);
      allow create: if signedIn() && inWorkspace(request.resource.data.workspaceId);
      allow update, delete: if inWorkspace(resource.data.workspaceId);
    }

    match /worker_entries/{entryId} {
      allow read: if inWorkspace(resource.data.workspaceId);
      allow create: if signedIn() && inWorkspace(request.resource.data.workspaceId);
      allow update, delete: if inWorkspace(resource.data.workspaceId);
    }

    match /workers/{workerId} {
      allow read: if inWorkspace(resource.data.workspaceId);
      allow create: if signedIn() && inWorkspace(request.resource.data.workspaceId);
      allow update, delete: if inWorkspace(resource.data.workspaceId);
    }

    match /subscriptions/{workspaceId} {
      allow read: if inWorkspace(workspaceId);
      allow write: if false;
    }

    match /usage_counters/{counterId} {
      allow read: if inWorkspace(resource.data.workspaceId);
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && request.auth.uid == resource.data.targetUserId
        && inWorkspace(resource.data.workspaceId);
      allow write: if false;
    }

    match /workspace_metrics/{workspaceId} {
      allow read: if inWorkspace(workspaceId);
      allow write: if false;
    }

    match /project_metrics/{projectId} {
      allow read: if inWorkspace(resource.data.workspaceId);
      allow write: if false;
    }

    match /drafts/{draftId} {
      allow read: if inWorkspace(resource.data.workspaceId);
      allow create: if inWorkspace(request.resource.data.workspaceId);
      allow update, delete: if inWorkspace(resource.data.workspaceId);
    }
  }
}
