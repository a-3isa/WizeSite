# WizeSite server configuration (copy to .env; never commit .env).
# Production: /srv/wizesite/.env, owned by root, mode 0600.

# Postgres connection used by the API and migrations.
DATABASE_URL=postgres://wizesite:change-me@localhost:5432/wizesite

# Firebase project whose Auth/App Check tokens the API accepts.
FIREBASE_PROJECT_ID=wize-site
# Path to a Firebase service-account JSON (Auth verify/delete, App Check verify, migration export).
GOOGLE_APPLICATION_CREDENTIALS=/srv/wizesite/secrets/firebase-service-account.json

# Attachment storage root and HMAC key for signed download URLs (32+ random bytes, hex).
FILES_ROOT=/srv/wizesite/files
FILES_SIGNING_KEY=replace-with-64-hex-chars

# Voice pipeline (same values as functions/.env).
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe

# RevenueCat webhook shared secret (Authorization header value).
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret

# Public base URL used when building signed file URLs.
PUBLIC_API_URL=https://api.example.com

# API listen port and log level (fatal|error|warn|info|debug|trace).
PORT=8080
LOG_LEVEL=info
